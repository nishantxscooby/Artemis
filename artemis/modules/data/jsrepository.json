  "angularjs": {
    "bowername": [
      "angularjs",
      "angular"
    ],
    "extractors": {
      "filename": [
        "angular(?:js)?[._-]([0-9]+(?:\\.[0-9]+)+)"
      ],
      "filecontent": [
        "@license AngularJS v([0-9][0-9.a-zA-Z_\\-]*)",
        "AngularJS\\s+v([0-9][0-9.a-zA-Z_\\-]*)"
      ],
      "uri": [
        "angular(?:js)?[._-]([0-9]+(?:\\.[0-9]+)+)"
      ],
      "hashes": {}
    },
    "vulnerabilities": [
      {
        "below": "1.6.0",
        "severity": "high",
        "exploit_type": "xss",
        "exploitability_note": "AngularJS expression sandbox escape. Any application using AngularJS <1.6 that evaluates user-controlled expressions (e.g. via ng-bind or URL parameters reflected into ng-app scope) is vulnerable to arbitrary JavaScript execution.",
        "identifiers": {
          "CVE": [
            "CVE-2016-9879"
          ]
        },
        "info": [
          "https://nvd.nist.gov/vuln/detail/CVE-2016-9879"
        ]
      },
      {
        "below": "1.8.0",
        "severity": "medium",
        "exploit_type": "xss",
        "exploitability_note": "XSS via $sanitize service bypass. Exploitable when the application uses ng-bind-html with user-controlled content.",
        "identifiers": {
          "CVE": [
            "CVE-2020-7676"
          ]
        },
        "info": [
          "https://nvd.nist.gov/vuln/detail/CVE-2020-7676"
